import os
import sys
import glob
import importlib.util

# 添加当前目录到模块搜索路径
sys.path.append(os.path.abspath(os.path.dirname(__file__)))

from wrapper_base import read_experiment_results, plot_progress_curves


# 动态导入原实验文件中的类定义
def import_class_from_file(file_path, class_name):
    """从指定文件动态导入类"""
    spec = importlib.util.spec_from_file_location("experiment_module", file_path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return getattr(module, class_name)


# 配置参数
OUTPUT_DIR = "experiments/outputs/"
PLOT_DIR = "experiments/plots/"
SOURCE_FILE = "Version_Lindon7_Beta.py"  # 原始实验文件路径
SOLVER_DISPLAY_NAMES = {
    "ASTRODFRF": "ASTRO-DF-C",
}


def generate_plots():
    # 确保输出目录存在
    os.makedirs(PLOT_DIR, exist_ok=True)

    # 动态导入原始实验文件中的类定义
    MoreWildProblem = import_class_from_file(SOURCE_FILE, "MoreWildProblem")

    # 获取所有pickle文件
    pickle_files = glob.glob(os.path.join(OUTPUT_DIR, "ASTRO_nonoise_on_MoreWild*.pickle"))

    # 按问题编号分组
    problem_experiments = {}
    for file_path in pickle_files:
        # 提取问题编号
        base_name = os.path.basename(file_path)
        probnum = base_name.split("_")[-1].split(".")[0]

        try:
            # 读取实验数据（此时MoreWildProblem类已可用）
            experiment = read_experiment_results(file_path)

            # 设置求解器显示名称
            original_solver_name = experiment.solver.name
            experiment.solver.name = SOLVER_DISPLAY_NAMES.get(original_solver_name, original_solver_name)

            # 按问题分组
            if probnum not in problem_experiments:
                problem_experiments[probnum] = []
            problem_experiments[probnum].append(experiment)
        except Exception as e:
            print(f"Error loading {file_path}: {str(e)}")
            continue

    # 为每个问题生成图表
    for probnum, experiments in problem_experiments.items():
        print(f"Generating plots for {probnum}...")

        # 设置绘图参数
        plot_params = {
            "experiments": experiments,
            "plot_type": "mean",
            "normalize": False,
            "all_in_one": True,
            "plot_CIs": True,
            "print_max_hw": True
        }

        # 生成并保存图表
        try:
            plot_progress_curves(**plot_params)
            print(f"Successfully saved plots for {probnum}")
        except Exception as e:
            print(f"Plotting failed for {probnum}: {str(e)}")


if __name__ == "__main__":
    generate_plots()
